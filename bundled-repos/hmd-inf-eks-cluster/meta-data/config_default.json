{
  "dependencies": {
    "base-vpc": {
      "instance_name": "base-vpc",
      "repo_name": "hmd-vpc",
      "version_spec": "~= 0.1",
      "required": "true"
    },  
    "datadog-lambda": {
      "repo_class_name": "hmd-inf-datadog-lambdas",
      "version_spec": "~= 0.1",
      "required": "true"
    }   
  }, 
  "instance_name": "eks-cluster-base",
  "version": "0.1.1",
  "deployment_id": "aaa",
  "repo_name": "hmd-inf-eks-cluster",
  "cluster_version": "1.21",
  "manage_aws_auth": false,
  "enable_irsa": true,
  "hmd_deployer_role": "hmd.neuronsphere.deploy",
  "cluster_log_types": [
    "api",
    "audit",
    "authenticator",
    "controllerManager",
    "scheduler"
  ],
 "enable_private_access": true,
 "enable_public_access": true,
 "log_retention": 365
}
