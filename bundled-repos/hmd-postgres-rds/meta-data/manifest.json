{
  "identifier": "some-project-repo-identifier",
  "name": "hmd-postgres-rds",
  "description": "an example project",
  "project_type": {
    "identifier": "some-project-type-identifier",
    "name": "microservice"
  },
  "build": {
    "commands": [
      [
        "cdktf"
      ]
    ]
  },
  "deploy": {
    "commands": [
      [
        "cdktf"
      ]
    ],
    "dependencies": {
      "base-vpc": {
        "repo_class_name": "hmd-vpc",
        "required": "true",
        "version_spec": "~= 0.1.19",
        "resource": {
          "resource_namespace": "network.neuronsphere.io",
          "resource_definition_name": "vpc",
          "version": "0.1.0",
          "version_spec": "~= 0.1"
        }
      },
      "datadog-lambda": {
        "repo_class_name": "hmd-inf-datadog-lambdas",
        "required": "true",
        "version_spec": "~= 0.1.7"
      },
      "rds-loggroup": {
        "repo_class_name": "hmd-inf-rds-loggroup",
        "required": "true",
        "version_spec": "~= 0.0"
      }
    },
    "default_configuration": {
      "engine_mode": "provisioned",
      "publicly_accessible": true,
      "db_username": "postgres",
      "db_engine": "aurora-postgresql",
      "engine_version": "17.9",
      "instance_type": "db.r7g.large",
      "allow_major_version_upgrade": false,
      "db_parameter_group": {
        "family": "aurora-postgresql17",
        "parameter_values": []
      },
      "cluster_parameter_group": {
        "family": "aurora-postgresql17",
        "parameter_values": []
      },
      "upgrade_config": {
        "skip_upgrade_safety": false,
        "snapshot_wait_timeout": 1800,
        "verify_row_counts": true,
        "row_count_tolerance_pct": 0.0,
        "pause_on_instance_change": false,
        "run_post_upgrade_analyze": true,
        "check_collation_drift": true,
        "pgbouncer": null
      }
    }
  }
}
