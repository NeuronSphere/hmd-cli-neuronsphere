{
  "identifier": "some-project-repo-identifier",
  "name": "hmd-inf-neptune",
  "description": "an example project",
  "project_type": {
    "identifier": "some-project-type-identifier",
    "name": "microservice"
  },
  "build": {
    "commands": [
      [
        "cdktf"
      ]
    ]
  },
  "deploy": {
    "commands": [
      [
        "cdktf"
      ]
    ],
    "dependencies": {
      "base-vpc": {
        "repo_class_name": "hmd-vpc",
        "version_spec": "~= 0.1.19",
        "required": "true"
      }
    },
    "default_configuration": {
      "engine": "neptune",
      "engine_version": "1.4.7.0",
      "instance_count": 1,
      "instance_size": "db.t3.medium",
      "backup_retention_period": 7,
      "preferred_backup_window": "07:00-09:00",
      "preferred_maintenance_window": "sun:09:00-sun:11:00",
      "iam_database_authentication_enabled": false,
      "db_parameter_group": {
        "family": "neptune1.4"
      },
      "cluster_parameter_group": {
        "family": "neptune1.4",
        "parameter_values": [
          {
            "name": "neptune_dfe_query_engine",
            "value": "enabled",
            "apply_method": "pending-reboot"
          },
          {
            "name": "neptune_query_timeout",
            "value": "120000"
          }
        ]
      }
    },
    "resources": {
      "graph-database": {
        "resource_namespace": "database.neuronsphere.io",
        "resource_definition_name": "graph-database",
        "version": "0.1.0",
        "produces": true,
        "role": "graph",
        "description": "A graph database (Amazon Neptune in the cloud; JanusGraph substitutes it locally, already part of core)."
      }
    }
  }
}