{
  "plugin_name": "artifact-lib",
  "hmdms_service": {
    "lambda_name": "hmd_ms_artifact_lib",
    "repo_class_name": "hmd-ms-artifact-lib",
    "buckets": [
      {"name": "artifact-librarian", "env_var": "ARTIFACT_BUCKET"}
    ]
  },
  "resources": {
    "services": [
      {"name": "artifact", "url": "http://hmd_proxy/hmd_ms_artifact_lib/"}
    ]
  },
  "dependencies": {
    "requires_plugins": [],
    "requires_services": ["graph-db"]
  },
  "env_var_override": "HMD_LOCAL_NEURONSPHERE_ENABLE_ARTIFACT_LIB",
  "enabled_by_default": true
}
